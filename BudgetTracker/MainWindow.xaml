<Window x:Class="BudgetTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BudgetTracker"
        mc:Ignorable="d"
        Title="Budget Tracker" Height="550" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Input form -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Date"/>
                <DatePicker x:Name="DateInput" Width="120"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Description"/>
                <TextBox x:Name="DescriptionInput" Width="180" Height="24"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Category"/>
                <ComboBox x:Name="CategoryInput" Width="120" IsEditable="True">
                    <ComboBoxItem Content="Food"/>
                    <ComboBoxItem Content="Rent"/>
                    <ComboBoxItem Content="Transport"/>
                    <ComboBoxItem Content="Bills"/>
                    <ComboBoxItem Content="Shopping"/>
                    <ComboBoxItem Content="Salary"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Type"/>
                <ComboBox x:Name="TypeInput" Width="100" SelectedIndex="1">
                    <ComboBoxItem Content="Income"/>
                    <ComboBoxItem Content="Expense"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Amount"/>
                <TextBox x:Name="AmountInput" Width="100" Height="24"/>
            </StackPanel>

            <Button Content="Add" Width="80" Height="26"
                    VerticalAlignment="Bottom" Click="AddButton_Click"/>
        </WrapPanel>

        <!-- Transactions table -->
        <DataGrid Grid.Row="1" x:Name="TransactionsGrid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="100"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Totals + delete -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Delete Selected"
                    Width="120" Height="26" Click="DeleteButton_Click"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="IncomeText"  Margin="0,0,25,0" FontWeight="Bold" Foreground="Green"/>
                <TextBlock x:Name="ExpenseText" Margin="0,0,25,0" FontWeight="Bold" Foreground="Firebrick"/>
                <TextBlock x:Name="BalanceText" FontWeight="Bold"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>